\f0\fs24 \cf0 ------------------------\
Persistent Volume:\
\
apiVersion: v1\
kind: PersistentVolume\
metadata:\
  name: pv-vol\
spec:\
  storageClassName: staticpv\
  capacity:\
    storage: 1Gi\
  accessModes:\
  - ReadWriteOnce\
  hostPath:\
    path: /tmp/static\
-----------------------------\
PersistentVolumeClaim:\
\
apiVersion: v1\
kind: PersistentVolumeClaim\
metadata:\
  name: pv-vol-claim\
spec:\
  storageClassName: staticpv\
  accessModes:\
  - ReadWriteOnce\
  resources:\
    requests:\
	  storage: 1Gi\
---------------------- \
Mount to a Pod:\
\
apiVersion: v1\
kind: Pod\
metadata:\
  name: ns-nginx\
  labels:\
    app: nginx\
spec:\
  volumes:\
  - name: volume\
    persistentVolumeClaim:\
	  claimName: pv-vol-claim\
  containers:\
  - name: nginx-container\
    image: nginx:latest\
	volumeMounts:\
	- mountPath: /home\
	  name: volume }